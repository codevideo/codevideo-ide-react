{
  "name": "codevideo-ide-react-examples",
  "private": true,
  "description": "Various examples on how to use the CodeVideoIDE component.",
  "version": "0.1.0",
  "license": "0BSD",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 8000",
    "start": "next dev -p 8000",
    "build": "next build",
    "build-for-gh-pages": "GITHUB_PAGES=true next build",
    "serve": "npx --yes serve out -l 7001",
    "clean": "rm -rf .next out",
    "redo": "npm install @fullstackcraftllc/codevideo-ide-react@latest --legacy-peer-deps && npm run clean && npm run dev",
    "rebuild": "npm install @fullstackcraftllc/codevideo-ide-react@latest --legacy-peer-deps && npm run clean && npm run build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fullstackcraftllc/codevideo-ide-react": "^0.0.185",
    "@fullstackcraftllc/codevideo-types": "^2.8.1",
    "@radix-ui/themes": "^3.2.1",
    "next": "16.4.5",
    "puppeteer-stream": "^3.0.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codevideo/codevideo-ide-react"
  },
  "bugs": {
    "url": "https://github.com/codevideo/codevideo-ide-react/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3"
  }
}
